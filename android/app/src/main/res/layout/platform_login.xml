<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="20dp" android:paddingRight="12dp">
        <TextView android:id="@+id/login_brand" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="QQ" android:textColor="#12AD70" android:textSize="13sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:layout_marginLeft="11dp">
            <TextView android:id="@+id/login_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="QQ音乐登录" android:textColor="#172B25" android:textStyle="bold" android:textSize="17sp" />
            <TextView android:id="@+id/login_origin" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="官方安全网页" android:textColor="#7B8983" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/login_compat" android:layout_width="68dp" android:layout_height="44dp"
            android:gravity="center" android:text="兼容视图" android:textColor="#73817B" android:textSize="11sp" />
        <TextView android:id="@+id/login_close" android:layout_width="40dp" android:layout_height="44dp"
            android:gravity="center" android:text="×" android:textColor="#73817B" android:textSize="26sp" android:contentDescription="取消登录" />
    </LinearLayout>
    <LinearLayout android:id="@+id/login_methods" android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/login_qq" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1"
            android:gravity="center" android:text="QQ登录" android:textSize="13sp" android:textStyle="bold" android:textColor="#087B57" />
        <TextView android:id="@+id/login_wechat" android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:layout_marginLeft="8dp"
            android:gravity="center" android:text="微信扫码" android:textSize="13sp" android:textColor="#73817B" />
    </LinearLayout>
    <ProgressBar android:id="@+id/login_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:max="100" android:progressTint="#12AD70" android:progressBackgroundTint="#E8F4EE" />
    <TextView android:id="@+id/login_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="10dp" android:paddingBottom="10dp"
        android:text="请在官方页面登录，完成后点下方按钮。" android:textSize="11sp" android:textColor="#73817B" android:background="#F5F9F6" />
    <WebView android:id="@+id/login_web" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingLeft="20dp" android:paddingRight="20dp" android:paddingTop="12dp" android:paddingBottom="14dp" android:background="#FFFFFF">
        <Button android:id="@+id/login_done" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/platform_login_primary" android:stateListAnimator="@null" android:text="完成登录"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:textAllCaps="false" android:minHeight="0dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="center" android:text="仅保存本机授权会话 · 不收集账号密码" android:textColor="#8A9890" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
