{
  "name": "ceru-music-mobile",
  "private": true,
  "version": "2.4.2",
  "upstreamVersion": "2.3.1",
  "description": "澜音 CeruMusic 手机版",
  "type": "module",
  "scripts": {
    "prepare:plugin-runtime": "node scripts/prepare-plugin-runtime.mjs",
    "predev": "npm run prepare:plugin-runtime",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:plugin-runtime",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild:only": "npm run prepare:plugin-runtime",
    "build:only": "vite build",
    "prepreview": "npm run prepare:plugin-runtime",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "npm run build:only && cap sync android",
    "cap:open": "cap open android",
    "android:apk": "cd android && gradlew.bat assembleRelease",
    "check:upstream": "node scripts/check-upstream.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "@ionic/vue": "^9.0.8",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^1.8.0",
    "@shiqianjiang/ceru-plugin-core": "0.3.14",
    "@shiqianjiang/ceru-plugin-sdk": "0.3.14",
    "buffer": "^6.0.3",
    "ionicons": "^8.1.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@shiqianjiang/ceru-plugin-issuer": "^0.3.14",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright-core": "^1.64.1",
    "sass-embedded": "^1.83.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
